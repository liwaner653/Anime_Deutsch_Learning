Enemy.

193
00:09:13,040 --> 00:09:13,140
Enemy.

194
00:09:13,140 --> 00:09:13,520
Enemy.

195
00:09:13,520 --> 00:09:13,660
Enemy.

196
00:09:13,720 --> 00:09:14,040
Enemy.

197
00:09:14,040 --> 00:09:14,160
Enemy.

198
00:09:14,160 --> 00:09:14,200
Enemy.

199
00:09:14,480 --> 00:09:14,620
Enemy.

200
00:09:14,800 --> 00:09:14,880
Enemy.

201
00:09:14,880 --> 00:09:15,480
Enemy.

202
